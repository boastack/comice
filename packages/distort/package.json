{
  "name": "@comice/distort",
  "version": "0.1.0",
  "description": "Field distortion that follows an input — bulge, lens, glass, the cursor as a force in a field.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --composite false --incremental false"
  },
  "peerDependencies": {
    "comice": "workspace:*"
  },
  "devDependencies": {
    "comice": "workspace:*"
  },
  "keywords": ["media", "distort", "webgl", "comice-plugin"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
