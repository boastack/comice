{
  "name": "comice",
  "version": "0.1.0",
  "description": "Comice is a GPU interaction engine for images, video, and typography, with native scroll, hover, pointer, drag, click, time, and audio drivers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "import": "./dist/machine.js",
      "require": "./dist/machine.cjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js",
      "require": "./dist/scheduler.cjs"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "import": "./dist/drivers/index.js",
      "require": "./dist/drivers/index.cjs"
    },
    "./drivers/audio": {
      "types": "./dist/drivers/audio.d.ts",
      "import": "./dist/drivers/audio.js",
      "require": "./dist/drivers/audio.cjs"
    },
    "./gl": {
      "types": "./dist/gl/index.d.ts",
      "import": "./dist/gl/index.js",
      "require": "./dist/gl/index.cjs"
    },
    "./mapping": {
      "types": "./dist/mapping.d.ts",
      "import": "./dist/mapping.js",
      "require": "./dist/mapping.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --composite false --incremental false"
  },
  "keywords": [
    "media",
    "webgl",
    "state-machine",
    "video",
    "image",
    "interaction",
    "zero-dependencies",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Olawale Balo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boastack/comice.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/boastack/comice/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/boastack/comice/issues"
  }
}
