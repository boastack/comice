{
  "name": "@comice/type",
  "version": "0.1.0",
  "description": "Media and live text meeting, and text behaving like media.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --composite false --incremental false"
  },
  "peerDependencies": {
    "comice": "workspace:*"
  },
  "devDependencies": {
    "comice": "workspace:*"
  },
  "keywords": ["media", "type", "comice-plugin"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
