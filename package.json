{
  "name": "comice",
  "description": "A state machine and event system for images and video interaction.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "dev": "turbo run build --watch",
    "size": "size-limit",
    "harness": "pnpm build && python3 -m http.server 8743 --directory .",
    "acceptance:serve": "bun harness/acceptance/serve.ts",
    "acceptance": "node harness/acceptance/run.mjs",
    "demo": "pnpm build && bun harness/acceptance/serve.ts",
    "test:morph": "pnpm build && bun build harness/morph/legacy-engine/shader.ts --target browser --external comice/gl --outdir harness/morph/build && node harness/morph/run.mjs && node harness/morph/clip-path.mjs && node harness/morph/demo-shapes.mjs && node harness/morph/inspector.mjs"
  },
  "size-limit": [
    {
      "name": "comice (core, ESM)",
      "path": "packages/core/dist/index.js",
      "limit": "10 kB"
    }
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/bun": "^1.4.2",
    "comice": "workspace:*",
    "playwright": "1.63.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
